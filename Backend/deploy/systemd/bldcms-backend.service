[Unit]
Description=BL-DCMS Backend (Gunicorn + Uvicorn workers)
Documentation=file:///opt/bldcms/Docs/DEPLOYMENT.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=CHANGE_ME_SERVICE_USER
Group=CHANGE_ME_SERVICE_GROUP
WorkingDirectory=/opt/bldcms/Backend

# DATABASE_URL/JWT_SECRET_KEY/CORS_ORIGINS are environment-variable-driven (see
# app/database/database.py, app/security/jwt.py, main.py) specifically so a real deployment can
# set them here without touching source code. CORS_ORIGINS matters less once Nginx serves the
# Dashboard and proxies the API on the same origin (same-origin requests never trigger CORS at
# all) - it remains set as defense-in-depth for any client that talks to the backend on a
# different origin. See CHANGE_CONFIGURATION.md for how to generate each value below.
Environment="DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DATABASE_HOST:5432/YOUR_DB_NAME"
Environment="JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
Environment="CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost"
Environment="DEBUG=false"
# Independent of DEBUG (log verbosity only, see app/services/otp_service.py). Set true only if
# this shed has no SMS/email OTP delivery channel and must rely on the OTP Logs admin screen;
# set false if a real OTP delivery channel is wired up.
Environment="SHOW_OTP_PLAINTEXT=true"

ExecStart=/opt/bldcms/Backend/venv/bin/gunicorn -c gunicorn.conf.py main:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30

# Crash recovery: restart unconditionally (covers clean exit, crash, and OOM-kill alike) after a
# short fixed delay - see Documentation/DEPLOYMENT.md for the reasoning and the burst-loop guard
# (StartLimitIntervalSec/StartLimitBurst) that prevents this from spinning forever against a
# persistently broken config (e.g. database unreachable).
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bldcms-backend

# Modest hardening that doesn't require restructuring the app's existing file layout (it still
# needs write access to Backend/logs, Backend/storage/pdfs, and the mounted backup HDD).
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
